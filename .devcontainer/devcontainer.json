{
  "name": "tomblogs24-hugo",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "HUGO_VERSION": "0.156.0",
      "GO_VARIANT": "latest"
    }
  },
  "remoteUser": "vscode",
  "overrideCommand": true,

  // Expose Hugo dev server
  "forwardPorts": [1313],
  "portsAttributes": {
    "1313": {
      "label": "Hugo server",
      "onAutoForward": "notify"
    }
  },

  // One-off setup after the container is first created
  "postCreateCommand": "git config --global --add safe.directory /workspaces/tomblogs24 && hugo mod tidy",

  // Start (or restart) Hugo every time the container starts
  "postStartCommand": "hugo server",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-vscode.go",
        "bierner.markdown-preview-github-styles"
      ]
    }
  }
}
